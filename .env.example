# Local development runs with seeded in-memory data when this is "memory".
# Production must use "supabase".
DATA_BACKEND=memory
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required when DATA_BACKEND=memory. Store only a scrypt hash, never plaintext.
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD_HASH=scrypt:16384:8:1:replace-with-base64url-salt:replace-with-base64url-hash
LOCAL_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
LOCAL_ADMIN_DISPLAY_NAME=Ting Ting Xu
# Local Client Login can use a separate account. If its hash/secret are blank,
# demo mode falls back to the local admin hash/secret but never its auth cookie.
LOCAL_CLIENT_EMAIL=client@example.test
LOCAL_CLIENT_PASSWORD_HASH=
LOCAL_CLIENT_SESSION_SECRET=
LOCAL_CLIENT_DISPLAY_NAME=Demo Applicant
SUPABASE_STORAGE_PUBLIC_BUCKET=site-media
SUPABASE_STORAGE_DRAFT_BUCKET=site-media-drafts
APPLICATION_UPLOAD_BUCKET=client-applications
# Used only by pnpm provision:supabase after an Auth user is owner-created.
ADMIN_USER_ID=
ADMIN_DISPLAY_NAME=Ting Ting Xu
# Optional owner-provisioned Supabase Auth client. Assignments remain private and
# should not be created until the form/consent version has legal/privacy approval.
CLIENT_USER_ID=
CLIENT_DISPLAY_NAME=
CLIENT_APPLICATION_RENTAL_SLUG=
# Server-only and at least 24 characters. Use the same owner-provisioned value
# for the Render web service and five-minute Cron service; never commit it.
REMINDER_CRON_SECRET=
# Each channel can be enabled independently.
# mock: generate safe fake delivery results without network calls.
# disabled: reject delivery attempts. live: use Resend (email) or Twilio (SMS).
EMAIL_PROVIDER_MODE=mock
SMS_PROVIDER_MODE=disabled
# Optional local-only latency used by the 100-recipient capacity test.
MOCK_PROVIDER_LATENCY_MS=0
RESEND_API_KEY=
EMAIL_FROM="Ting Ting Xu <notifications@silverkey.ca>"
CONTACT_TO_EMAIL=tingtingtech@outlook.com
ALERT_TO_EMAIL=
OPERATIONAL_ALERTS_ENABLED=false
# Owner upload confirmations and weekly tenant summaries. If blank, the app
# falls back to ALERT_TO_EMAIL and then LOCAL_ADMIN_EMAIL.
OWNER_NOTIFICATION_TO_EMAIL=
# Daily overdue reminders are queued only after this local 24-hour time.
OWNER_DAILY_OVERDUE_TIME=09:00
# ISO weekday (1=Monday ... 7=Sunday) and local 24-hour time.
OWNER_WEEKLY_SUMMARY_DAY=1
OWNER_WEEKLY_SUMMARY_TIME=09:00
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a Messaging Service SID in production. TWILIO_FROM_NUMBER is supported
# for a restricted Twilio trial dry run; configure exactly one sender.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Production value must exactly equal:
# https://<public-host>/api/webhooks/twilio
TWILIO_STATUS_CALLBACK_URL=
# Production requires a public HTTPS origin, with no query string or fragment.
APP_BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=America/Vancouver
REMINDERS_FORCE_PAUSED=true
# OpenClaw Automation API kill switches. Production defaults stay off until
# each staged rollout gate is approved.
AUTOMATION_API_ENABLED=false
AUTOMATION_ALLOW_LOOPBACK_HTTP=false
AUTOMATION_MUTATIONS_ENABLED=false
AUTOMATION_CONFIRMATIONS_ENABLED=false
AUTOMATION_TENANT_IMPORT_ENABLED=false
# At least 32 random characters; server-only. Never give this or any Supabase
# credential to OpenClaw.
AUTOMATION_TOKEN_PEPPER=
AUTOMATION_IMPORT_BUCKET=automation-imports
