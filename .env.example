# Local development runs with seeded in-memory data when this is "memory".
# Production must use "supabase".
DATA_BACKEND=memory
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required when DATA_BACKEND=memory. Store only a scrypt hash, never plaintext.
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD_HASH=scrypt:16384:8:1:replace-with-base64url-salt:replace-with-base64url-hash
LOCAL_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
LOCAL_ADMIN_DISPLAY_NAME=Ting Ting Xu
SUPABASE_STORAGE_PUBLIC_BUCKET=site-media
SUPABASE_STORAGE_DRAFT_BUCKET=site-media-drafts
# Used only by pnpm provision:supabase after an Auth user is owner-created.
ADMIN_USER_ID=
ADMIN_DISPLAY_NAME=Ting Ting Xu
REMINDER_CRON_SECRET=replace-with-a-long-random-secret
# mock: generate safe fake delivery results without network calls.
# disabled: reject every delivery attempt. live: use Resend and Twilio.
NOTIFICATION_PROVIDER_MODE=mock
# Optional local-only latency used by the 100-recipient capacity test.
MOCK_PROVIDER_LATENCY_MS=0
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_TO_EMAIL=
ALERT_TO_EMAIL=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=
APP_BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=America/Vancouver
REMINDERS_FORCE_PAUSED=true
# OpenClaw Automation API kill switches. Production defaults stay off until
# each staged rollout gate is approved.
AUTOMATION_API_ENABLED=false
AUTOMATION_MUTATIONS_ENABLED=false
AUTOMATION_CONFIRMATIONS_ENABLED=false
AUTOMATION_TENANT_IMPORT_ENABLED=false
# At least 32 random characters; server-only. Never give this or any Supabase
# credential to OpenClaw.
AUTOMATION_TOKEN_PEPPER=
AUTOMATION_IMPORT_BUCKET=automation-imports
