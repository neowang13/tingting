{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schedule", "expectedVersion"],
  "properties": {
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rentDueDay", "dayOfMonth", "localTime", "timezone", "channels", "isEnabled"],
      "properties": {
        "rentDueDay": { "type": "integer", "minimum": 1, "maximum": 31 },
        "dayOfMonth": { "type": "integer", "minimum": 1, "maximum": 31 },
        "localTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "timezone": { "type": "string", "default": "America/Vancouver" },
        "channels": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["email", "sms"] } },
        "emailTemplateId": { "type": ["string", "null"], "format": "uuid" },
        "smsTemplateId": { "type": ["string", "null"], "format": "uuid" },
        "isEnabled": { "const": false }
      }
    },
    "expectedVersion": { "type": ["string", "null"], "format": "date-time" }
  }
}

