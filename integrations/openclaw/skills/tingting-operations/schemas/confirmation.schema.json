{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["digest", "acknowledged"],
  "properties": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "acknowledged": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    }
  }
}

