{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["file", "mode", "sourceSystem"],
  "properties": {
    "file": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["create_only", "create_or_update"] },
    "sourceSystem": { "type": "string", "minLength": 1, "maxLength": 60 }
  }
}

