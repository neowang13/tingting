{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["fullName", "propertyLabel", "email", "ownerConfirmation"],
  "properties": {
    "sourceSystem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "default": "openclaw"
    },
    "externalReference": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 120
    },
    "fullName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "propertyLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "unitLabel": {
      "type": ["string", "null"],
      "maxLength": 60
    },
    "moveInDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "rentDueDay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31,
      "default": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phoneE164": {
      "type": ["string", "null"],
      "pattern": "^\\+[1-9]\\d{7,14}$"
    },
    "preferredChannels": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2,
      "items": {
        "enum": ["email", "sms"]
      }
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "default": "America/Vancouver"
    },
    "internalNotes": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "ownerConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmedAt", "documentDigest"],
      "properties": {
        "confirmedAt": {
          "type": "string",
          "format": "date-time"
        },
        "documentDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
