{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["changes", "expectedVersion"],
  "properties": {
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "propertyLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "unitLabel": {
          "type": ["string", "null"],
          "maxLength": 60
        },
        "moveInDate": {
          "type": ["string", "null"],
          "format": "date"
        },
        "rentDueDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "email": {
          "type": ["string", "null"],
          "format": "email"
        },
        "phoneE164": {
          "type": ["string", "null"],
          "pattern": "^\\+[1-9]\\d{7,14}$"
        },
        "preferredChannels": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2,
          "items": {
            "enum": ["email", "sms"]
          }
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "internalNotes": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "isActive": {
          "type": "boolean"
        }
      }
    },
    "expectedVersion": {
      "type": "string",
      "format": "date-time"
    }
  }
}
