{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "channel",
    "status",
    "source",
    "reason",
    "evidenceReference",
    "permissionRecordedAt",
    "expectedVersion"
  ],
  "properties": {
    "channel": { "enum": ["email", "sms"] },
    "status": { "const": "allowed" },
    "source": { "type": "string", "minLength": 1, "maxLength": 120 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
    "evidenceReference": { "type": "string", "minLength": 1, "maxLength": 300 },
    "permissionRecordedAt": { "type": "string", "format": "date-time" },
    "expectedVersion": { "type": "string", "format": "date-time" }
  }
}
