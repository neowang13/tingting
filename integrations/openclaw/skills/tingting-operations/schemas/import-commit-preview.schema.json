{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectedSourceDigest", "expectedPreviewVersion"],
  "properties": {
    "expectedSourceDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "expectedPreviewVersion": {
      "type": "string",
      "format": "date-time"
    }
  }
}
