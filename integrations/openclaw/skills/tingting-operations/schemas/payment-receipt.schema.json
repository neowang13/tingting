{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "period", "mediaRef"],
  "properties": {
    "tenantId": { "type": "string", "format": "uuid" },
    "period": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "mediaRef": {
      "type": "string",
      "pattern": "^media://inbound/[A-Za-z0-9][A-Za-z0-9._-]{0,254}\\.(pdf|jpg|jpeg|png|webp)$"
    }
  }
}
